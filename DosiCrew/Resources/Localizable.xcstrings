    "Add a medication under the Medications tab to get started.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege im Tab „Medikamente“ ein Medikament an, um loszulegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a medication under the Medications tab to get started."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un medicamento en la pestaña Medicamentos para empezar."
          }
        }
      }
    },
    "Add a medication with its dose and schedule, and it will show up on the Today screen.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege ein Medikament mit Dosierung und Zeitplan an — dann erscheint es auf „Heute“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a medication with its dose and schedule, and it will show up on the Today screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un medicamento con su dosis y horario y aparecerá en la pantalla Hoy."
          }
        }
      }
    },
