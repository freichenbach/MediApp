    "“Given late” means more than an hour after the planned time.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Verspätet gegeben“ heißt: mehr als eine Stunde nach der geplanten Zeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Given late” means more than an hour after the planned time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Administradas con retraso» significa más de una hora después de la hora prevista."
          }
        }
      }
    },
    "“Missing” gathers deliberately skipped, refused and not recorded; the columns above separate them.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Fehlend“ fasst bewusst ausgelassen, verweigert und nicht eingetragen zusammen; die Spalten oben trennen sie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Missing” gathers deliberately skipped, refused and not recorded; the columns above separate them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Faltantes» agrupa omitidas, rechazadas y sin registrar; las columnas de arriba las separan."
          }
        }
      }
    },
    "“Not recorded” means nobody ticked the dose off. It does not mean it was missed — the report says so too.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Nicht eingetragen“ heißt, dass niemand die Gabe abgehakt hat. Es heißt nicht, dass sie ausgefallen ist — das steht auch im Bericht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Not recorded” means nobody ticked the dose off. It does not mean it was missed — the report says so too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Sin registrar» significa que nadie marcó la dosis. No significa que se omitiera; el informe también lo dice."
          }
        }
      }
    }
  },
  "version": "1.0"
}
