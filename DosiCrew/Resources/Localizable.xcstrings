  "strings": {
    "%@ due for %@.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ fällig für %2$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ due for %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ para %2$@."
          }
        }
      }
    },
    "%@ · logged by %@": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · erfasst von %2$@"
