          }
        }
      }
    },
    "The invitation link stays valid until you stop sharing. Anybody who already has it does not need a new one.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Einladungslink bleibt gültig, bis Sie das Teilen beenden. Wer ihn schon hat, braucht keinen neuen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The invitation link stays valid until you stop sharing. Anybody who already has it does not need a new one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El enlace de invitación sigue siendo válido hasta que deje de compartir. Quien ya lo tenga no necesita uno nuevo."
          }
        }
      }
    },
    "The lower number is not below the upper one — are they the wrong way round?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der untere Wert liegt nicht unter dem oberen — sind sie vertauscht?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The lower number is not below the upper one — are they the wrong way round?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El valor inferior no es menor que el superior: ¿están intercambiados?"
          }
        }
      }
    },
    "The medication plan could not be loaded on this iPhone. Restart the app; if that does not help, reinstall it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Medikamentenplan konnte auf diesem iPhone nicht geladen werden. Starte die App neu; hilft das nicht, installiere sie neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The medication plan could not be loaded on this iPhone. Restart the app; if that does not help, reinstall it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cargar el plan de medicación en este iPhone. Reinicia la app; si no funciona, vuelve a instalarla."
          }
        }
      }
    },
    "The others lose access immediately. Your own copy of the plan stays on this iPhone.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die anderen verlieren sofort den Zugriff. Deine eigene Kopie des Plans bleibt auf diesem iPhone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The others lose access immediately. Your own copy of the plan stays on this iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los demás pierden el acceso de inmediato. Tu copia del plan permanece en este iPhone."
          }
        }
      }
    },
    "The period could not be worked out.": {
      "extractionState": "manual",
