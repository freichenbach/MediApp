    "Everyone you invite sees the same plan and can tick off doses. Changes appear on the other iPhones within a few seconds.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Eingeladenen sehen denselben Plan und können Gaben abhaken. Änderungen erscheinen innerhalb weniger Sekunden auf den anderen iPhones."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everyone you invite sees the same plan and can tick off doses. Changes appear on the other iPhones within a few seconds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las personas invitadas ven el mismo plan y pueden marcar dosis. Los cambios aparecen en los otros iPhones en unos segundos."
          }
        }
      }
    },
