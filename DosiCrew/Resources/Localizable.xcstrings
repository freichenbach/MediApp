        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Above 100 % is not a reading."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por encima del 100 % no es una lectura."
          }
        }
      }
    },
