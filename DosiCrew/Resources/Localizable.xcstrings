    "Each iPhone reminds on its own. When somebody else ticks a dose off, the pending reminder disappears here too.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes iPhone erinnert für sich. Hakt jemand anderes eine Gabe ab, verschwindet die Erinnerung auch hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each iPhone reminds on its own. When somebody else ticks a dose off, the pending reminder disappears here too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada iPhone avisa por su cuenta. Si otra persona marca una dosis, el recordatorio pendiente también desaparece aquí."
          }
        }
      }
    },
    "Each time becomes one line to tick off on the Today screen.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Uhrzeit wird auf „Heute“ zu einer Zeile zum Abhaken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each time becomes one line to tick off on the Today screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada hora se convierte en una línea que marcar en la pantalla Hoy."
          }
        }
      }
    },
