    },
    "A dose below was ticked off by more than one person. Check with the others before giving anything else.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Gabe unten wurde von mehreren Personen abgehakt. Sprich dich mit den anderen ab, bevor du weiter gibst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A dose below was ticked off by more than one person. Check with the others before giving anything else."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una dosis de abajo fue marcada por más de una persona. Habla con los demás antes de administrar nada más."
          }
        }
      }
    },
