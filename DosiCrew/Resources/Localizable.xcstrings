    "Dose due for %@.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gabe fällig für %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dose due for %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca una dosis para %@."
          }
        }
      }
    },
    "Doses are worked out from these rules; nothing is stored in advance.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Gaben werden aus diesen Regeln berechnet; nichts wird im Voraus gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Doses are worked out from these rules; nothing is stored in advance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las dosis se calculan a partir de estas reglas; no se guarda nada por adelantado."
          }
        }
      }
    },
    "DosiCrew helps you organise who gives what and when. It does not check doses, interactions or contraindications — that stays with your doctor or pharmacist.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DosiCrew hilft beim Organisieren, wer wann was gibt. Sie prüft weder Dosierungen noch Wechsel- oder Nebenwirkungen — das bleibt Sache von Ärztin, Arzt oder Apotheke."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DosiCrew helps you organise who gives what and when. It does not check doses, interactions or contraindications — that stays with your doctor or pharmacist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "DosiCrew te ayuda a organizar quién da qué y cuándo. No comprueba dosis, interacciones ni contraindicaciones: eso corresponde a tu médico o farmacia."
          }
        }
      }
    },
    "Drops": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tropfen"
