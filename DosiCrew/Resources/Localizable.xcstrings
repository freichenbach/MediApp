    "Doses are worked out from these rules; nothing is stored in advance.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Gaben werden aus diesen Regeln berechnet; nichts wird im Voraus gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Doses are worked out from these rules; nothing is stored in advance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las dosis se calculan a partir de estas reglas; no se guarda nada por adelantado."
