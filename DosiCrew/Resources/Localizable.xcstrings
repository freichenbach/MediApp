          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The plan could not be opened, so nothing was recorded. Please tick it off in DosiCrew."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo abrir el plan y no se registró nada. Márcalo en DosiCrew."
          }
        }
      }
    },
    "The plan disappears from this iPhone. The others keep it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Plan verschwindet von diesem iPhone. Bei den anderen bleibt er."
          }
        },
