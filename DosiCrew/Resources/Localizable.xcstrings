    "Medications, schedules, logged doses and events for this child are removed on every shared iPhone. This cannot be undone.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Medikamente, Zeitpläne, erfasste Gaben und Ereignisse dieses Kindes verschwinden auf allen beteiligten iPhones. Das lässt sich nicht rückgängig machen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Medications, schedules, logged doses and events for this child are removed on every shared iPhone. This cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
