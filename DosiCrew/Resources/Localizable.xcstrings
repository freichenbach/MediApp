    "The invitation could not be opened, so the shared plan is not here. %@": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einladung konnte nicht geöffnet werden, der geteilte Plan fehlt deshalb hier. %@"
          }
        },
        "en": {
