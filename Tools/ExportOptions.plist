<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>method</key>
	<string>app-store-connect</string>
	<key>destination</key>
	<string>export</string>
	<!-- Manual, because the whole pipeline now signs with a certificate and a
	     profile that were made by hand. Automatic would reach back to cloud
	     signing, whose profiles are marked "Xcode managed" and which the
	     archive step refuses. -->
	<key>signingStyle</key>
	<string>manual</string>
	<key>signingCertificate</key>
	<string>Apple Distribution</string>
	<key>provisioningProfiles</key>
	<dict>
		<key>es.reichenbach.DosiCrew</key>
		<string>__PROFILE_NAME__</string>
	</dict>
	<key>uploadSymbols</key>
	<true/>
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
	<key>teamID</key>
	<string>__TEAM_ID__</string>
	<!-- Required for anything that uses CloudKit. Without it the exported app
	     carries no com.apple.developer.icloud-container-environment, CloudKit
	     cannot resolve the container, and the app traps on launch inside
	     -[CKContainerImplementation _checkRequiredEntitlements]. The export
	     itself succeeds, so the omission is invisible until a device runs it.
	     TestFlight and the App Store always talk to Production. -->
	<key>iCloudContainerEnvironment</key>
	<string>Production</string>
</dict>
</plist>
